#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=1427|field=Notes"
msgid "A red, red, rose."
msgstr "아주 새빨간 장미 한 송이."

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
