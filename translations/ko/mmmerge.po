msgid "Snergle's Axe"
msgstr "스너글의 도끼"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=2118|field=Notes"
msgid ""
"Quest Item:  The finest Dwarven axe ever created in Enroth, Snergle's name "
"is traced in flowing dwarven runes across the blade."
msgstr "퀘스트 아이템: 엔로스에서 제작된 최고의 드워프 도끼. 칼날에는 스너글의 이름이 유려한 드워프 룬 문자로 새겨져 있다."

