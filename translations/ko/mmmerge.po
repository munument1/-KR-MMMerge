"mmmerge/Text localization/LANG_ItemsTxt.txt|id=651|field=NotIdentifiedName"
msgid "Ground Wyvern Horn"
msgstr "와이번 뿔 가루"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
