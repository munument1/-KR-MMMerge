msgid "Prison Key"
msgstr "감옥 열쇠"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=620|field=Notes"
msgid ""
"Quest Item: A key of the type commonly used for dungeon cell door locks."
msgstr "퀘스트 아이템: 던전 감옥 문 자물쇠에 흔히 사용되는 종류의 열쇠."

