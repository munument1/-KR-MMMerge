msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=159|field=Name"
msgid "Shaman's Wand of Lashing"
msgstr "주술사의 채찍 마법봉"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=159|field=Notes"
msgid ""
"Something rattles ominously within the gog skull topping this wand - product"
" of Ogre mage magic. To use it, you must equip it like a weapon."
msgstr ""
"이 지팡이 꼭대기에 있는 고그 해골 안에서 무언가가 불길하게 덜그럭거린다. 오우거 마법사의 마법으로 만들어진 이 지팡이를 사용하려면 "
"무기처럼 장착해야 한다."

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt ""
"mmmerge/Text localization/LANG_ItemsTxt.txt|id=159|field=NotIdentifiedName"
