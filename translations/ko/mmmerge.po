msgid "Reduces monster size to one third normal"
msgstr "몬스터 크기를 원래의 3분의 1로 축소"

#. EN: source/en/mm8/Data/10LocLANG.EnglishT/Spells.txt
#. KO: Data/Text localization/KO_SpellsTxt.txt
msgctxt ""
"mmmerge/inherited/mm8/Spells.txt|table=SpellsTxt|id=92|field=GrandMaster"
