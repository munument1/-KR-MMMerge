#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB02.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB02.STR|string=6"
msgid "The stew tasts good - you feel better (+5 hits)."
msgstr "스튜가 맛있습니다. 기분이 나아집니다. (체력 +5)"

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB02.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB02.STR|string=7"
msgid "Crates filled with wood chips."
msgstr "나무 조각이 든 상자."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB03.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB03.STR|string=10"
msgid "There is of nothing of value in the crates."
msgstr "상자 안에는 가치 있는 것이 없습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB03.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB03.STR|string=2"
msgid "You find jerked beef in the sack (+10 food)."
msgstr "자루에서 육포를 찾았습니다. (식량 +10)"

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB03.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB03.STR|string=3"
msgid "Mead filled barrel."
msgstr "벌꿀주가 든 통."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB03.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB03.STR|string=4"
msgid "You drink the mead and are feeling good."
msgstr "벌꿀주를 마시자 기분이 좋아집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB03.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB03.STR|string=5"
msgid "Stew filled bowl."
msgstr "스튜가 담긴 그릇."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB03.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB03.STR|string=6"
msgid "The stew tastes good - you feel better (+5 hits)."
msgstr "스튜가 맛있습니다. 기분이 나아집니다. (체력 +5)"

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB03.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB03.STR|string=7"
msgid "Crates filled with wood chips."
msgstr "나무 조각이 든 상자."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB04.STR|string=1"
msgid "Bench"
msgstr "벤치"

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB04.STR|string=2"
msgid "You find a small wooden dowl."
msgstr "작은 나무못을 찾았습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB04.STR|string=4"
msgid "There seems to be a small hole in the crate."
msgstr "상자에 작은 구멍이 있는 것 같습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB04.STR|string=5"
msgid "You fit the dowl into the hole and a small key pops out."
msgstr "나무못을 구멍에 끼우자 작은 열쇠가 튀어나옵니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB04.STR|string=6"
msgid "The crate is padlocked - you need a key."
msgstr "상자에 자물쇠가 채워져 있습니다. 열쇠가 필요합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB04.STR|string=7"
msgid "You fit the key into the padlock and it pops open."
msgstr "열쇠를 자물쇠에 끼우자 철컥 열립니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB05.STR|string=1"
msgid "Crumbling boulder."
msgstr "부서져 가는 바위."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB05.STR|string=2"
msgid "The vent brings in fresh air."
msgstr "환기구에서 신선한 공기가 들어옵니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB05.STR|string=3"
msgid "Poisonous spores force you back."
msgstr "독성 포자 때문에 뒤로 물러납니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB05.STR|string=4"
msgid "Vent."
msgstr "환기구."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB05.STR|string=5"
msgid "The air smells stale and makes you cough."
msgstr "공기가 탁해 기침이 납니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB05.STR|string=6"
msgid ""
"\"A small nymph comes out of a hole in the floor thanking you for clearing "
"the spores, he shakes your hand vigorously then disappears down the hole "
"(which somehow disappears after him). +500 experience.\""
msgstr ""
"작은 님프가 바닥 구멍에서 나와 포자를 치워 준 것에 감사하며 힘차게 악수합니다. 그러고는 구멍 속으로 사라지는데, 이상하게도 구멍도 "
"함께 사라집니다. 경험치 +500."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB05.STR|string=7"
msgid "Small switch."
msgstr "작은 스위치."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=1"
msgid "The mine shakes and shifts around you."
msgstr "광산이 주위에서 흔들리고 뒤틀립니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=10"
msgid "Some loose debris overhead falls on you."
msgstr "머리 위의 느슨한 잔해가 떨어집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=11"
msgid "The vein dried up."
msgstr "광맥이 고갈되었습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=12"
msgid "You were fast enough to dodge the bigger rocks."
msgstr "재빨리 움직여 큰 바위들을 피했습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=13"
msgid "Even though the water is dirty it still refreshes."
msgstr "물은 더럽지만 그래도 상쾌해집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=14"
msgid "The dirty water leaves a bad taste in your mouth."
msgstr "더러운 물 때문에 입안에 나쁜 맛이 남습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=15"
msgid "The doors seem stuck."
msgstr "문들이 걸린 것 같습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=16"
msgid "The switch is locked in place."
msgstr "스위치가 제자리에 고정되어 있습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=17"
msgid "Boulders."
msgstr "바위 더미."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=18"
msgid "This cave-in blocks any further access into the mine."
msgstr "낙석 때문에 광산 안쪽으로 더 들어갈 수 없습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=19"
msgid "Small rocks and debris fall from above. "
msgstr "작은 돌과 잔해가 위에서 떨어집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=2"
msgid "Looks like an earthquake hit this mine."
msgstr "이 광산에 지진이 난 것 같습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=3"
msgid "Water filled barrel."
msgstr "물이 든 통."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=4"
msgid "Sack filled with mining equipment."
msgstr "채굴 장비가 든 자루."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=6"
msgid "This room looks really unstable."
msgstr "이 방은 매우 불안정해 보입니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=8"
msgid "As you pull the lever rocks fall from above."
msgstr "레버를 당기자 위에서 돌이 떨어집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB06.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB06.STR|string=9"
msgid "You mine the gold with no problem."
msgstr "문제없이 금을 채굴합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=1"
msgid "There is a strong smell of gas pervading the air."
msgstr "공기 중에 강한 가스 냄새가 퍼져 있습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=10"
msgid "Hundreds of snakes crawl out of the floor and bite you. "
msgstr "수백 마리의 뱀이 바닥에서 기어 나와 물어뜯습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=11"
msgid "A voice hisses -Walk the path of the snake-."
msgstr "목소리가 쉭쉭거리며 말합니다. \"뱀의 길을 걸어라.\""

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=12"
msgid ""
"\"A voice whispers -I am the spirit of the swamp, congratulations, take what"
" you may and leave in peace-\""
msgstr "목소리가 속삭입니다. 나는 늪의 정령이다. 축하한다. 원하는 것을 가져가고 평안히 떠나라."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=2"
msgid "Small glittering pool."
msgstr "작게 반짝이는 연못."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=3"
msgid "The water cools you down."
msgstr "물이 몸을 식혀 줍니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=5"
msgid "The torches Ignite and so does the swamp gas."
msgstr "횃불에 불이 붙으며 늪 가스도 함께 타오릅니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=6"
msgid "Hundreds of snakes crawl out of the floor and bite you."
msgstr "수백 마리의 뱀이 바닥에서 기어 나와 물어뜯습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=7"
msgid "Swamp gas forces you back couching and gagging."
msgstr "늪 가스 때문에 기침과 구역질을 하며 뒤로 물러납니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=8"
msgid "\"You drink the water, with no effect.\""
msgstr "물을 마시지만 아무 효과도 없습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB07.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB07.STR|string=9"
msgid "The switch does not work."
msgstr "스위치가 작동하지 않습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=1"
msgid "Shard filled caskets."
msgstr "수정 조각이 든 관."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=10"
msgid "Someone has gone to a lot of trouble carving all these murals"
msgstr "누군가 이 벽화들을 새기는 데 엄청난 공을 들였습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=11"
msgid " This razor sharp crystal is too immature to harvest."
msgstr "이 면도날처럼 날카로운 수정은 아직 채굴하기에 너무 덜 자랐습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=12"
msgid "You study the mural and get a good feeling inside."
msgstr "벽화를 살펴보자 마음이 편안해집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=13"
msgid "Carved mural."
msgstr "새겨진 벽화."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=15"
msgid "The cabinet is filled with old and broken harvesting tools."
msgstr "장 안에는 낡고 부서진 채굴 도구가 가득합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=2"
msgid "Barrel is filled with crystal shards (worthless)."
msgstr "통에는 가치 없는 수정 조각이 가득합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=3"
msgid "Table with implements atop."
msgstr "도구가 놓인 탁자."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=4"
msgid "You see a scattered of refining tools and small crystal shavings."
msgstr "정제 도구와 작은 수정 부스러기가 흩어져 있습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=5"
msgid "Sacks."
msgstr "자루."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=6"
msgid "The sacks are filled with flawed crystal shards (worthless)."
msgstr "자루에는 가치 없는 불량 수정 조각이 들어 있습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=8"
msgid "You mine the crystal in its raw form (+300 gold)."
msgstr "원석 상태의 수정을 채굴합니다. (금화 +300)"

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB08.STR|string=9"
msgid "You refine the crystal you harvested (+200 to its value)."
msgstr "채굴한 수정을 정제합니다. (가치 +200)"

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=10"
msgid "Your muscles expand as you take a drink."
msgstr "한 모금 마시자 근육이 부풀어 오릅니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=11"
msgid "The liquid has lost its effectiveness."
msgstr "액체는 더 이상 효과가 없습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=12"
msgid "You flip the switch and hear grating off in the distance."
msgstr "스위치를 젖히자 멀리서 긁히는 소리가 들립니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=13"
msgid ""
"\"A skeletal knight steps out of a forming mist and says -To let you pass I "
"will need you to say a prayer over my bones found close by, when this is "
"done you can pass-\""
msgstr ""
"안개 속에서 해골 기사가 나타나 말합니다. 지나가려면 근처에 있는 내 뼈 앞에서 기도해 주어야 한다. 그 일을 마치면 통과할 수 있다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=15"
msgid "The bones feel incredibly cold to the touch."
msgstr "뼈는 손을 대기 힘들 만큼 차갑습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=16"
msgid "You say a prayer over the bones. "
msgstr "뼈 앞에서 기도합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=17"
msgid ""
"\"The skeletal knight appears from the mist, nods and disappears into the "
"mist again.\""
msgstr "해골 기사가 안개 속에서 나타나 고개를 끄덕인 뒤 다시 안개 속으로 사라집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=18"
msgid "Something slimey moves behind this brick wall."
msgstr "이 벽돌 벽 뒤에서 끈적한 무언가가 움직입니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=19"
msgid "Wall with missing bricks."
msgstr "벽돌이 빠진 벽."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=2"
msgid "With some muscle you move the switch down."
msgstr "힘을 써 스위치를 아래로 내립니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=20"
msgid "You find a grey key where one of the bricks used to be."
msgstr "벽돌이 빠진 자리에서 회색 열쇠를 찾았습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=21"
msgid "You find a silver key where one of the bricks used to be."
msgstr "벽돌이 빠진 자리에서 은색 열쇠를 찾았습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=23"
msgid "You need a key to open this chest."
msgstr "이 상자를 열려면 열쇠가 필요합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=24"
msgid ""
"\"A skeletal looking cleric steps out of a quick forming mist and says - I "
"was tortured down here long ago and my bones were scattered throughout this "
"level, I will let you pass only when you have destroyed what remains of me "
"and return here, you will feel which bones they are when you see them...-  "
"He fades away.\""
msgstr ""
"갑자기 피어오른 안개 속에서 해골 같은 성직자가 나타나 말합니다. 오래전 이곳에서 고문당해 내 뼈가 이 층 곳곳에 흩어졌다. 내 유해를 "
"모두 파괴하고 돌아오면 통과시켜 주겠다. 그 뼈를 보면 느낌으로 알 수 있을 것이다... 그는 이내 사라집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=25"
msgid "You find and destroy one of the clerics bones. "
msgstr "성직자의 뼈 하나를 찾아 파괴합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=26"
msgid ""
"The cleric appears again and nods at you -Thank you I will never forget your"
" kindness I can rest in peace at last -  He then fades away."
msgstr ""
"성직자가 다시 나타나 고개를 끄덕입니다. \"고맙다. 그 친절을 잊지 않겠다. 이제야 편히 쉴 수 있겠구나.\" 그는 다시 사라집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=27"
msgid "You get a bad feeling from the bones."
msgstr "뼈에서 불길한 느낌이 듭니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=28"
msgid "Iron Maiden"
msgstr "아이언 메이든"

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=29"
msgid "There's nothing but spikes in the Iron maiden."
msgstr "아이언 메이든 안에는 가시밖에 없습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=3"
msgid "\"The switch is stuck, you need someone stronger to move it.\""
msgstr "스위치가 걸렸습니다. 더 힘센 사람이 필요합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=30"
msgid "You search the Burial niche and find some gold."
msgstr "매장 벽감을 뒤져 금화를 찾았습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=31"
msgid "The bones seems to charge with electricity !!."
msgstr "뼈에 전기가 차오르는 것 같습니다!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=32"
msgid "These are really old bones...really old."
msgstr "정말 오래된 뼈입니다... 아주 오래됐습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=33"
msgid "You gain knowledge from these ancient bones."
msgstr "이 고대의 뼈에서 지식을 얻습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=34"
msgid "Long dead adventurer."
msgstr "죽은 지 오래된 모험가."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=35"
msgid "You search the body and find some gold."
msgstr "시신을 뒤져 금화를 찾았습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=37"
msgid ""
"\"A mist forms and a shadowy figure of a skeletal noblemen steps in front of"
" you saying -The undead are restless in this tomb, before I can let you "
"leave you must visit each one of them- the noblemen shoves you back and then"
" vanishes.\""
msgstr ""
"안개가 피어오르며 해골 귀족의 그림자가 앞을 막고 말합니다. 이 무덤의 언데드들이 안식을 찾지 못하고 있다. 떠나려면 그들을 하나씩 모두"
" 찾아가야 한다. 귀족은 당신을 밀쳐 낸 뒤 사라집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=38"
msgid ""
"\"The skeletal noblemen appears from the mist, nods his head, then "
"vanishes.\""
msgstr "해골 귀족이 안개 속에서 나타나 고개를 끄덕인 뒤 사라집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=4"
msgid "Crates."
msgstr "상자."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=40"
msgid "Skeleton in a cage."
msgstr "우리 안의 해골."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=41"
msgid "The skeleton grabs for you."
msgstr "해골이 당신을 붙잡으려 합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=42"
msgid "A strange force reaches out of the wall and grabs you."
msgstr "벽에서 기묘한 힘이 뻗어 나와 당신을 붙잡습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=45"
msgid "You find some half decent food in the sack."
msgstr "자루에서 그럭저럭 먹을 만한 음식을 찾았습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=46"
msgid "A scrawled message on the brick reads   2=1  3=2  1=3"
msgstr "벽돌에 휘갈겨 쓴 글이 있습니다.  2=1  3=2  1=3"

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=5"
msgid "The crates are all empty."
msgstr "상자들은 모두 비어 있습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/ZDDB10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/ZDDB10.STR|string=7"
