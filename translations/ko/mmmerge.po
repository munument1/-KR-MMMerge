#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=1426|field=Name"
msgid "Vase"
msgstr "꽃병"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=1426|field=Notes"
msgid ""
"Quest Item:  This small, porcelain vase has been etched with the "
"inscription, \"To Lord Markham, for a great job in the war, Queen "
"Catherine.\""
msgstr ""
"퀘스트 아이템: 이 작은 자기 꽃병에는 \"전쟁에서 큰 공을 세운 마크햄 경에게, 캐서린 여왕이 바칩니다.\"라는 글귀가 새겨져 "
"있습니다."

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt ""
"mmmerge/Text localization/LANG_ItemsTxt.txt|id=1426|field=NotIdentifiedName"
msgid "Vase"
