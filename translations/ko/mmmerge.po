#. EN: source/en/mmmerge/Data/10LocLANG.T/6D01.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D01.STR|string=24"
msgid "GoblinWatch"
msgstr "고블린워치"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D02.str
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D02.str|string=10"
msgid "You open the cage and remove the bones."
msgstr "우리를 열고 뼈를 꺼냅니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D02.str
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D02.str|string=5"
msgid "You've Rescued a child!  How patriarchal of you"
msgstr "아이를 구출했습니다! 참으로 가부장적이군요."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D02.str
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D02.str|string=6"
msgid "This Rock is covered in bat guano"
msgstr "이 바위는 박쥐 구아노로 뒤덮여 있습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D02.str
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D02.str|string=7"
msgid "You harvest the guano and put it in your pouch"
msgstr "구아노를 채취해 주머니에 넣습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D02.str
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D02.str|string=8"
msgid "\"You pick up some guano, but have nowhere to put it.\""
msgstr "구아노를 조금 집었지만 담을 곳이 없습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D04.STR|string=16"
msgid "Lord of Fire"
msgstr "불의 군주"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D04.STR|string=17"
msgid "Hall of the Fire Lord"
msgstr "불의 군주의 회관"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D04.STR|string=3"
msgid "All must have amber.  Take life force!"
msgstr "모두 호박을 지녀야 한다. 생명력을 바쳐라!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D04.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D04.STR|string=9"
msgid "\"Ah, delicious amber!\""
msgstr "아, 맛있는 호박이로군!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D05.STR|string=25"
msgid "The bones feel weird (+5 Poison resistance permanent)"
msgstr "뼈에서 이상한 기운이 느껴집니다. (독 저항 +5 영구 증가)"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D05.STR|string=26"
msgid "The bones feel weird (+5 Magic resistance permanent)"
msgstr "뼈에서 이상한 기운이 느껴집니다. (마법 저항 +5 영구 증가)"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D05.STR|string=31"
msgid "The bones feel weird (+5 Might permanent)"
msgstr "뼈에서 이상한 기운이 느껴집니다. (힘 +5 영구 증가)"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D05.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D05.STR|string=8"
msgid "Black liquid filled barrel"
msgstr "검은 액체가 든 통"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=11"
msgid "Ca-Click!"
msgstr "철컥!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=12"
msgid "Snick!"
msgstr "찰칵!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=18"
msgid ""
"\"You cannot see me, hear me or touch me.  I lie behind the stars and alter "
"what is real, I am what you really fear, Close your eyes and come I near. "
"What am I?\""
msgstr ""
"나를 볼 수도, 들을 수도, 만질 수도 없다. 나는 별들 뒤에 숨어 현실을 뒤바꾸며, 네가 진정 두려워하는 것이다. 눈을 감으면 내가 "
"다가온다. 나는 무엇인가?"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=21"
msgid "Answer?  "
msgstr "정답은?"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=22"
msgid "Incorrect"
msgstr "틀렸습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=23"
msgid ""
"\"I go through an apple, or point out your way, I fit in a bow, then a "
"target, to stay. What am I?\""
msgstr "나는 사과를 꿰뚫고, 길을 가리키기도 한다. 활에 걸렸다가 과녁에 박힌다. 나는 무엇인가?"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=26"
msgid ""
"\"What consumes rocks, levels mountains, destroys wood, pushes the clouds "
"across the sky, and can make a young one old?\""
msgstr "바위를 삼키고 산을 깎으며 나무를 썩게 하고 구름을 하늘로 밀어 보내며 젊은이를 늙게 하는 것은 무엇인가?"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=28"
msgid ""
"\"Alive without breath, as cold as death, never thirsty ever drinking, all "
"in mail never clinking, ever travelling, never walking, mouth ever moving, "
"never talking.  What am I? \""
msgstr ""
"숨 없이 살아 있고 죽음처럼 차갑다. 목마르지 않으나 늘 마시며, 비늘 갑옷을 입었으나 소리 나지 않는다. 늘 움직이지만 걷지 않고, "
"입을 움직이지만 말하지 않는다. 나는 무엇인가?"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=31"
msgid "Magical Wall"
msgstr "마법의 벽"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=34"
msgid "Shadow Guild"
msgstr "섀도 길드"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D08.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D08.STR|string=7"
msgid "Click!"
msgstr "딸깍!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D09.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D09.STR|string=14"
msgid "You are not smart enough!"
msgstr "지력이 부족합니다!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D09.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D09.STR|string=15"
msgid "Snergle's Iron Mines"
msgstr "스너글의 철광산"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D09.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D09.STR|string=6"
msgid "Bookshelves"
msgstr "책장"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D09.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D09.STR|string=7"
msgid "\"You thumb through the books, but find nothing of interest.\""
msgstr "책을 훑어보지만 흥미로운 것은 찾지 못했습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D10.STR|string=11"
msgid "Dragoons' Keep"
msgstr "드라군 성채"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D10.STR|string=7"
msgid "Caught!"
msgstr "들켰습니다!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D10.STR|string=8"
msgid "Rats!"
msgstr "젠장!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D10.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D10.STR|string=9"
msgid "Are those footsteps?"
msgstr "저건 발소리인가?"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D11.str
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D11.str|string=4"
msgid "This Door won't budge."
msgstr "이 문은 꼼짝도 하지 않습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D11.str
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D11.str|string=7"
msgid "Corlagon's Estate"
msgstr "코라곤의 영지"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D12.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D12.STR|string=1"
msgid "Skull Door"
msgstr "해골 문"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D12.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D12.STR|string=5"
msgid ""
"\"I am Sir John Silver.  I was most foully murdered by my Lieutenant when I "
"discovered that he was involved with his sorcererous brother and a senior "
"priest in the Temple of Baa in a conspiracy against King Roland.  There are "
"no good men left in the order, and it sickens my soul to say so.\""
msgstr ""
"나는 존 실버 경이다. 내 부관이 마법사인 형제와 바의 신전 고위 사제와 함께 롤랜드 왕을 상대로 음모를 꾸미고 있음을 알아낸 뒤, 그 "
"부관에게 비참하게 살해당했다. 기사단에는 더 이상 선한 자가 남아 있지 않다. 이런 말을 해야 한다는 사실이 내 영혼을 병들게 하는구나."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D12.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D12.STR|string=6"
msgid ""
"\"I am Sir John Silver.  I was most foully murdered by my Lieutenant when I "
"discovered that he was involved with his sorcererous brother and a senior "
"priest in the Temple of Baa in a conspiracy against King Roland.  I am "
"grateful for the rescue of my niece, Melody, from my treacherous Lieutenant "
"by you.  I will open a secret door to a nearby treasure room for you as a "
"reward for your heroism.\""
msgstr ""
"나는 존 실버 경이다. 내 부관이 마법사인 형제와 바의 신전 고위 사제와 함께 롤랜드 왕을 상대로 음모를 꾸미고 있음을 알아낸 뒤, 그 "
"부관에게 비참하게 살해당했다. 배신한 부관에게서 내 조카 멜로디를 구해 준 것에 감사한다. 그 영웅적인 행동에 대한 보답으로 가까운 "
"보물방의 비밀문을 열어 주겠다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=10"
msgid "You search the tree and find something."
msgstr "나무를 뒤져 무언가를 찾아냅니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=11"
msgid "+5 Personality permanent to Druids and Clerics."
msgstr "드루이드와 성직자의 인격이 영구적으로 5 증가합니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=12"
msgid "The statue shifts as your touch it."
msgstr "석상에 손을 대자 움직입니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=13"
msgid "The rock shifts at your touch."
msgstr "바위에 손을 대자 움직입니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=14"
msgid "The pool shimmers as you touch it."
msgstr "연못에 손을 대자 물결이 반짝입니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=15"
msgid "The monolith feels strange to the touch."
msgstr "모놀리스에 손을 대자 이상한 감촉이 느껴집니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=16"
msgid "You find nothing."
msgstr "아무것도 찾지 못했습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=17"
msgid "The tree shakes at your touch."
msgstr "나무에 손을 대자 흔들립니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=18"
msgid "The flowers smell nice."
msgstr "꽃에서 좋은 향기가 납니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=2"
msgid "Druid statue"
msgstr "드루이드 석상"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=20"
msgid "Strange rock"
msgstr "기묘한 바위"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=3"
msgid "Strange tree"
msgstr "기묘한 나무"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=4"
msgid "Monolith"
msgstr "모놀리스"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=5"
msgid "Sacred Pool"
msgstr "신성한 연못"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=6"
msgid "Evil Altar"
msgstr "사악한 제단"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D13.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D13.STR|string=8"
msgid "Nice Flower"
msgstr "예쁜 꽃"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D14.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D14.STR|string=10"
msgid "The niche is empty."
msgstr "벽감은 비어 있습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D14.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D14.STR|string=13"
msgid "Tomb of Ethric the Mad"
msgstr "광인 에스릭의 무덤"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D14.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D14.STR|string=4"
msgid "Elevator"
msgstr "승강기"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D14.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D14.STR|string=5"
msgid "Platform"
msgstr "발판"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D14.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D14.STR|string=8"
msgid "Fumes make you feel sick."
msgstr "연기 때문에 속이 메스껍습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D14.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D14.STR|string=9"
msgid "You find something among the bones."
msgstr "뼈 사이에서 무언가를 찾아냅니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D15.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D15.STR|string=11"
msgid "The gate will not budge."
msgstr "문은 꼼짝도 하지 않습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D15.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D15.STR|string=12"
msgid "You find something around the bed."
msgstr "침대 주변에서 무언가를 찾아냅니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D15.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D15.STR|string=13"
msgid "Something rumbles off in the distance."
msgstr "멀리서 무언가 우르릉거립니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D15.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D15.STR|string=14"
msgid "The bed(s) are empty."
msgstr "침대는 비어 있습니다."

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D15.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D15.STR|string=16"
msgid "Icewind Keep"
msgstr "아이스윈드 성채"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D15.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D15.STR|string=7"
msgid "Various Foodstuff bags"
msgstr "각종 식량 자루"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D15.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D15.STR|string=8"
msgid "Throne"
msgstr "왕좌"

#. EN: source/en/mmmerge/Data/10LocLANG.T/6D16.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/6D16.STR|string=10"
msgid "You have found two keys!"
