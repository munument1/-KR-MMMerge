msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=148|field=Name"
msgid "Jade Amulet"
msgstr "옥 부적"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=148|field=Notes"
msgid ""
"A large polished jade stone decorates and adds value to this simple amulet."
msgstr "큼지막하게 다듬어진 옥돌이 이 소박한 부적을 장식하고 가치를 더해줍니다."

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
