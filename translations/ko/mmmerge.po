"기술 점수 +3"

#. EN: source/en/mmmerge/Data/Text localization/LANG_NPCText.txt
#. KO: Data/Text localization/KO_NPCText.txt
msgctxt ""
"mmmerge/Text "
"localization/LANG_NPCText.txt|table=NPCText|id=735|field=<default>"
msgid ""
"You win!\n"
"+5 Skill Points"
msgstr ""
"승리했다!\n"
"기술 점수 +5"

#. EN: source/en/mmmerge/Data/Text localization/LANG_NPCText.txt
#. KO: Data/Text localization/KO_NPCText.txt
msgctxt ""
"mmmerge/Text "
"localization/LANG_NPCText.txt|table=NPCText|id=736|field=<default>"
msgid ""
"You win!\n"
"+7 Skill Points"
msgstr ""
"승리했다!\n"
"기술 점수 +7"

#. EN: source/en/mmmerge/Data/Text localization/LANG_NPCText.txt
#. KO: Data/Text localization/KO_NPCText.txt
msgctxt ""
