msgstr "기사 조각상"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=1419|field=Notes"
msgid ""
"Quest Item:  A small statuette of a knightly figure.  The statuette seems to"
" radiate a faint magic."
msgstr "퀘스트 아이템: 기사 형상의 작은 조각상. 조각상에서는 희미한 마법의 기운이 뿜어져 나오는 듯하다."

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt ""
