msgid "False Report"
msgstr "허위 보고서"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=602|field=Notes"
msgid ""
"Quest Item: A letter given to you by Arion Hunter for delivery to the Dread "
"Pirate Stanley on Regna."
msgstr "퀘스트 아이템: 아리온 헌터가 레그나에 있는 드레드 해적 스탠리에게 전달해 달라고 준 편지."

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
