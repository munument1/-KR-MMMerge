msgstr "충전된 연결석"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=624|field=Notes"
msgid "Smooth half-transparent connector stone charged by time traveling."
msgstr "시간 여행을 통해 에너지를 얻은 매끄럽고 반투명한 연결석."

