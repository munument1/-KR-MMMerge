msgid "Tobersk Brandy"
msgstr "토베르스크 브랜디"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=645|field=Notes"
msgid ""
"Brandy made from the processed pulp of Dagger Wound Islands grown tobersk "
"fruit."
msgstr "대거 운드 제도에서 재배한 토베르스크 열매의 가공된 과육으로 만든 브랜디."

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
