msgid "Power Stone"
msgstr "힘의 돌"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=618|field=Notes"
msgid ""
"Quest Item: A facet carved stone of dark glassy rock. When tapped it "
"produces a medium bell tone."
msgstr "퀘스트 아이템: 어둡고 유리처럼 투명한 암석으로 만든, 다면체 조각이 된 돌. 두드리면 중간 정도의 종소리가 납니다."

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt ""
"mmmerge/Text localization/LANG_ItemsTxt.txt|id=618|field=NotIdentifiedName"
msgid "Stone"
msgstr "돌"

