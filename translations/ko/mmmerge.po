msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=619|field=Name"
msgid "Pirate Leader's Key"
msgstr "해적 두목의 열쇠"

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
#. KO: Data/Text localization/KO_ItemsTxt.txt
msgctxt "mmmerge/Text localization/LANG_ItemsTxt.txt|id=619|field=Notes"
msgid "Quest Item: The key you took from Blackwell Cooper's body."
msgstr "퀘스트 아이템: 블랙웰 쿠퍼의 시체에서 가져온 열쇠."

#. EN: source/en/mmmerge/Data/Text localization/LANG_ItemsTxt.txt
