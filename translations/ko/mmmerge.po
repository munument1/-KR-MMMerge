msgstr "틀렸습니다!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/CD1.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/CD1.STR|string=18"
msgid "Ok!"
msgstr "좋아!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/CD1.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/CD1.STR|string=19"
msgid "\"Who told you!  Alright, you may pass!\""
msgstr "누가 알려 준 거지! 좋아, 지나가도 된다!"

#. EN: source/en/mmmerge/Data/10LocLANG.T/CD1.STR
#. KO: Data/Text localization/KO_MapStrings.txt
msgctxt "mmmerge/10LocLANG.T/CD1.STR|string=21"
