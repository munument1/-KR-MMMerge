msgctxt ""
"mmmerge/Text "
"localization/LANG_NPCText.txt|table=NPCText|id=1502|field=<default>"
msgid "Drunk!"
msgstr "취했다!"

#. EN: source/en/mmmerge/Data/Text localization/LANG_NPCText.txt
